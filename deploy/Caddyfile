{
    admin off
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }

    reverse_proxy frontend:80

    log {
        output stdout
        format json
    }
}
