# Public HTTPS edge
APP_DOMAIN=ops-staging.example.com
ACME_EMAIL=operations@example.com

# Immutable images published by .github/workflows/release.yml
WEB_IMAGE=ghcr.io/masumtech/production-ops-api-web:replace-with-full-main-commit-sha
FRONTEND_IMAGE=ghcr.io/masumtech/production-ops-api-frontend:replace-with-full-main-commit-sha

# Django security
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ops-staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ops-staging.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_TRUST_X_FORWARDED_PROTO=True
DJANGO_DATABASE_CONN_MAX_AGE=60

# Private data services
POSTGRES_DB=production_ops
POSTGRES_USER=production_ops
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://production_ops:replace-with-a-long-random-database-password@db:5432/production_ops?connect_timeout=5
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379/0
